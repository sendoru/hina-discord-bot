# 답변/기억 모델 provider: openai, gemini, openrouter
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
# 기존 OPENAI_MODEL도 OpenAI 설정의 호환 alias로 계속 읽습니다.

# fixed는 LLM_MODEL 하나를 사용합니다. adaptive는 별도 LLM 호출 없이 작업 특성에 따라
# fast/smart 모델과 추론 강도를 선택합니다. 채팅과 장기 기억은 같은 모델 pool을 공유합니다.
MODEL_ROUTING_MODE=fixed
# [runtime] 채팅 adaptive score가 이 값 이상이면 smart tier를 선택합니다. 허용 범위: 0.1~10.0
MODEL_ROUTING_SMART_THRESHOLD=2.0
# [runtime] 장기 기억 adaptive score가 이 값 이상이면 smart tier를 선택합니다. 허용 범위: 0.1~10.0
MEMORY_ROUTING_SMART_THRESHOLD=2.0
LLM_FAST_MODEL=
LLM_SMART_MODEL=
# provider 공통 전체 생성 예산입니다. reasoning/thought token도 이 한도에 포함될 수 있습니다.
FAST_MAX_OUTPUT_TOKENS=4096
SMART_MAX_OUTPUT_TOKENS=8192

# 채팅 adaptive routing의 의미 분류기입니다. 장기 기억 routing에는 적용되지 않습니다.
# off: 현재 chat-v3만 사용, shadow: 분류 결과를 기록하되 실제 선택은 chat-v3 유지,
# active: 객관적 부하와 분류 결과를 결합한 chat-hybrid-v1을 실제 선택에 사용합니다.
# startup-only 설정이며 변경 후 재시작해야 합니다.
ROUTING_CLASSIFIER_MODE=off
# 비우면 LLM_PROVIDER를 사용합니다. 다른 provider를 쓰면 MODEL을 반드시 명시해야 합니다.
ROUTING_CLASSIFIER_PROVIDER=
# 같은 provider에서 비우면 LLM_FAST_MODEL을 사용합니다.
ROUTING_CLASSIFIER_MODEL=
# 비우면 classifier provider의 일반 API key를 재사용합니다. 별도 quota/account 분리에 사용할 수 있습니다.
ROUTING_CLASSIFIER_API_KEY=
ROUTING_CLASSIFIER_TIMEOUT_SECONDS=4
ROUTING_CLASSIFIER_MAX_OUTPUT_TOKENS=256

# 사용하는 provider의 키만 필수입니다.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DISCORD_TOKEN=

# Gemini의 추론 강도만 provider별로 별도 설정합니다.
# fixed에서는 GEMINI_THINKING_LEVEL, adaptive에서는 fast/smart 값을 채팅과 기억 모두 사용합니다.
GEMINI_THINKING_LEVEL=low
GEMINI_FAST_THINKING_LEVEL=minimal
GEMINI_SMART_THINKING_LEVEL=medium

# 장기 기억 요약의 provider 공통 전체 생성 예산입니다. Gemini에서는 thought token도 포함됩니다.
# fast/smart memory route 모두 이 예산을 사용합니다.
MEMORY_MAX_OUTPUT_TOKENS=4096

# 아래에서 [runtime]으로 표시한 값은 시작 시 기본값입니다.
# 봇 관리자 /config set으로 저장한 SQLite override가 있으면 그 값이 우선하며 즉시 적용됩니다.
# DB override와 환경변수가 모두 없으면 코드에 정의된 기본값을 사용합니다.

# [runtime] 외부 모델 요청으로 보낼 수 있는 대화 문맥의 최종 경계입니다.
# privacy-safe 기본값은 bot_interactions_only입니다. 현재 채널에서 히나가 직접 참여한 대화만
# 허용하므로, 다른 사용자의 직접 호출과 그에 대한 히나 답변도 포함하지만 일반 채널 잡담,
# target history·cross-user public memory·서버 공통 메모는 차단합니다.
# 현재 사용자가 이번 호출에서 명시적으로 답장 대상으로 고른 자기 메시지도 허용합니다.
# full은 신뢰하는 provider에서 주변 문맥까지 사용해야 할 때만 명시적으로 선택하세요.
EXTERNAL_CONTEXT_POLICY=bot_interactions_only

# [runtime] 일반 답변에서 provider의 웹 검색 기능을 fallback으로 허용합니다.
# OpenAI는 Responses web_search, Gemini는 Google Search, OpenRouter는 web plugin으로 변환합니다.
# 관계·사건·인지 범위, 최신 상태, 공개 일정처럼 외부 확인이 반드시 필요한 질문은 검색을 강제하고,
# 시간 의존 가능성만 있는 애매한 질문에는 검색 도구만 제공해 모델이 필요할 때 선택하게 합니다.
CHAT_WEB_SEARCH=true

# 현재 시각과 상대 날짜 해석에 사용하는 봇 런타임 기준입니다.
# RUNTIME_DEFAULT_LOCATION은 [runtime] 설정이며, 날씨·교통·영업시간 등에서 사용자가 지역을
# 생략했을 때만 fallback으로 쓰고 실제 사용자 위치라고 간주하지 않습니다. 값이 있으면 일반
# 잡담에서 현재 날씨를 약 20분 단위로 캐시해 ambient context로도 사용합니다.
# 비우면 날씨 캐시 네트워크 호출도 하지 않습니다.
RUNTIME_TIMEZONE=Asia/Seoul
RUNTIME_LOCALE=ko-KR
RUNTIME_DEFAULT_LOCATION=

# 현재 호출 메시지에서 vision input으로 전달할 source별 개수 상한입니다.
# 0이면 해당 source를 비전 입력에서 끕니다. 세 값은 각각 0~32, 합계는 32 이하여야 합니다.
# 파일 크기 제한은 별도로 개별 5 MiB, 한 호출 합계 12 MiB가 적용됩니다.
VISION_MAX_ATTACHMENTS=4
VISION_MAX_EMOJIS=12
VISION_MAX_STICKERS=8

# [runtime] 메시지 시작에서 인식할 호출어. 쉼표 구분, 1~20개, 각각 최대 32자입니다.
# 캐릭터의 이름/설정/프로필 사실은 프롬프트와 lore에서 관리합니다.
CALL_PREFIXES=히나야
# 호출어/멘션만 보내고 본문이 비어 있을 때의 고정 응답입니다. 변경 후 재시작해야 적용됩니다.
EMPTY_CALL_REPLY=응? 무슨 일이야?
# SPECIAL_DM_USER_ID의 빈 호출에만 사용합니다. 비우면 EMPTY_CALL_REPLY를 그대로 사용합니다.
SPECIAL_DM_EMPTY_CALL_REPLY=응, 선생님. 무슨 일이야?
# 모델이 빈 문자열을 반환했을 때 Discord에 보낼 최종 fallback입니다.
EMPTY_RESPONSE_REPLY=응, 선생님.
# [runtime] false: DM에서도 멘션 또는 호출어가 필요합니다.
DM_ALWAYS_REPLY=false
# [runtime] 공개 채널에서 같은 사용자가 나눈 대화를 DM에서만 추가 참고합니다.
PUBLIC_SERVER_MEMORY_IN_DM=true
# 기억/메모/이모지뿐 아니라 /instruction, /knowledge, /config override도 이 SQLite에 저장합니다.
# data/는 Git에서 제외되고 Docker에서는 named volume에 보존됩니다.
DATABASE_PATH=data/hina.sqlite3
# 비우면 패키지 내 기본 프롬프트를 사용합니다. UTF-8 파일 경로를 지정할 수 있습니다.
CHARACTER_PROMPT_PATH=
# 아래 세 경로는 hina-migrate-runtime 전용입니다. 일반 봇/eval 런타임 Settings에는
# 포함되지 않으며, 예전 JSON 저장 형식을 SQLite로 이전할 때만 읽습니다.
INSTRUCTION_PATH=data/instructions.json
RUNTIME_LORE_PATH=data/runtime_lore.json
CONTEXT_PATH=data/contexts.json
# 비우면 초대된 모든 서버에서 사용합니다. 쉼표로 구분한 서버 ID입니다.
ALLOWED_GUILD_IDS=
COOLDOWN_SECONDS=5
MAX_CONCURRENT_REQUESTS=3
# [runtime] fixed 모드에서 사용하는 provider 공통 전체 생성 예산입니다.
MAX_OUTPUT_TOKENS=1000
SUMMARY_EVERY=8
HISTORY_TURNS=12

# [runtime] 최근 채널 문맥 본문 합계 문자 수 상한. 0이면 전달하지 않습니다.
CHANNEL_CONTEXT_CHARS=6000

# 앱 소유자 외에 이모지·기억 모드·동적 instruction/knowledge·runtime config 관리를 허용할 Discord 사용자 ID.
# 여러 명이면 쉼표로 구분합니다. 예: BOT_ADMIN_IDS=123456789012345678,234567890123456789
# 변경 후 봇을 재시작해야 적용됩니다. 서버 Administrator 권한과는 별개입니다.
BOT_ADMIN_IDS=

# 이 사용자와의 DM에서만 선생님 관계 적용. 비우면 모두 일반 관계. 관리 권한과 별개.
SPECIAL_DM_USER_ID=

# 승인된 설정 중 현재 질문과 관련된 항목만 별도 API 호출 없이 전달합니다.
# 비우면 패키지의 src/hina_bot/data/lore.jsonl을 사용합니다.
LORE_PATH=
# [runtime]
LORE_MAX_ITEMS=6
LORE_MAX_CHARS=3200
# [runtime] false면 community_meme 항목을 런타임에서 전부 제외합니다.
COMMUNITY_LORE=true

# [runtime] DM 최근 대화 본문 합계 상한(문자 수); 최신 완전한 턴부터 포함
HISTORY_MAX_CHARS=12000
# 빈 값이면 사용량 파일 로깅 끄기
USAGE_LOG_PATH=data/logs/usage.jsonl
# 빈 값이면 Discord 요청 lifecycle 이벤트 파일 로깅 끄기
EVENT_LOG_PATH=data/logs/events.jsonl
