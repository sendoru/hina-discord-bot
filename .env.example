# Hina Discord Bot — 환경 설정
# [runtime] 시작 기본값. SQLite /config 또는 대시보드 override가 우선합니다.
# [startup] 변경 후 봇을 재시작해야 적용됩니다.
# 비어 있는 값의 의미는 각 항목의 설명을 따릅니다.
# 기존 .env 정리: hina-env-normalize --check / --write (자동 백업).
# DB에 적용된 runtime 설정까지 내보내려면 hina-env-export를 사용합니다.

# === 01. Discord / 접근 권한 ===

# [startup] Discord 봇 토큰.
DISCORD_TOKEN=

# [startup] 허용 서버 ID 목록(쉼표 구분). 비우면 초대된 모든 서버.
ALLOWED_GUILD_IDS=

# [startup] 봇 관리 권한을 부여할 사용자 ID 목록(쉼표 구분). 서버 Administrator 권한과 별개.
BOT_ADMIN_IDS=

# [startup] 일반 사용자 멘션의 실제 알림 허용. @everyone/@here/역할 멘션은 항상 차단.
ALLOW_USER_MENTIONS=true


# === 02. LLM / Provider 및 모델 ===

# [startup] 답변·기억 처리 Provider: openai | gemini | openrouter.
LLM_PROVIDER=openai

# [startup] 사용할 Provider의 API 키. classifier의 별도 Provider 키도 필요할 수 있습니다.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# [runtime] fixed는 LLM_MODEL, adaptive는 fast/smart 모델 선택. 비어 있는 fast/smart는 시작 시 LLM_MODEL 상속.
# 답변과 기억은 같은 모델 pool을 사용합니다.
MODEL_ROUTING_MODE=fixed
LLM_MODEL=gpt-4.1-mini
LLM_FAST_MODEL=
LLM_SMART_MODEL=

# [runtime] 채팅 및 기억의 smart 선택 점수 기준(0.1~10.0). 각 routing 점수의 의미는 다릅니다.
MODEL_ROUTING_SMART_THRESHOLD=2.0
MEMORY_ROUTING_SMART_THRESHOLD=2.0

# [runtime] 전체 생성 토큰 예산(fixed, fast, smart, 기억 순). 추론 토큰도 포함될 수 있습니다.
# adaptive의 명시적 장문 요청은 fast 모델에서 smart 토큰 예산을 사용할 수 있습니다.
MAX_OUTPUT_TOKENS=1000
FAST_MAX_OUTPUT_TOKENS=4096
SMART_MAX_OUTPUT_TOKENS=8192
MEMORY_MAX_OUTPUT_TOKENS=4096

# [runtime] 답변의 provider 요청별 데드라인(초, 1~300). provider 관리형 도구 포함; 로컬 도구 후속 요청은 별도 예산.
ANSWER_TIMEOUT_SECONDS=45.0

# [runtime] Native Decision의 선택 작업별 데드라인(초, 0.25~30). OpenAI 배치는 공통 데드라인을 공유.
# 실패 시 허용된 후보 전체로 fallback; 일반 답변·출력 교정과 독립.
DECISION_TIMEOUT_SECONDS=1.5


# === 03. OpenAI 전용 ===

# [runtime] fixed/fast/smart 추론 강도. default는 모델 기본값.
# none | minimal | low | medium | high | xhigh | max 중 지원 범위는 모델별로 다릅니다.
OPENAI_REASONING_EFFORT=default
OPENAI_FAST_REASONING_EFFORT=default
OPENAI_SMART_REASONING_EFFORT=default


# === 04. Gemini 전용 ===

# [runtime] fixed/fast/smart 추론 강도: minimal | low | medium | high.
GEMINI_THINKING_LEVEL=low
GEMINI_FAST_THINKING_LEVEL=minimal
GEMINI_SMART_THINKING_LEVEL=medium

# [runtime] Gemini 요청 원문 저장. 디버깅 시에만 활성화 권장.
GEMINI_STORE_INTERACTIONS=false

# [runtime] 호출 영역별 저장 여부. 주석 상태는 전역 값 상속; true/false 모두 명시적 override.
# GEMINI_STORE_ANSWER_INTERACTIONS=false
# GEMINI_STORE_MEMORY_INTERACTIONS=false
# GEMINI_STORE_CLASSIFIER_INTERACTIONS=false
# GEMINI_STORE_OUTPUT_REPAIR_INTERACTIONS=false
# GEMINI_STORE_KNOWLEDGE_INTERACTIONS=false

# [runtime] auto | interactions | generate_content. auto는 검색 도구 오류 시 GenerateContent로 단일 재시도.
# 연속 오류 2회 후 5분간 검색 경로 우회. 비검색 요청은 Interactions 유지.
GEMINI_SEARCH_API_MODE=auto

# [runtime] text | pdf. PDF 대상: all 또는 answer,memory,knowledge,decisions 중 쉼표 구분.
GEMINI_PDF_TRANSPORT=text
GEMINI_PDF_SCOPE=all

# [startup] 선택적 로컬 TrueType 폰트 경로. 입력 언어를 지원하는 폰트 사용.
GEMINI_PDF_FONT=


# === 05. OpenRouter 전용 ===

# [runtime] default는 모델 기본값, none은 추론 비활성화 요청. 그 외 강도는 모델별 지원 범위에 따릅니다.
# fast/smart의 inherit는 fixed 설정을 상속합니다.
OPENROUTER_REASONING_EFFORT=default
OPENROUTER_FAST_REASONING_EFFORT=inherit
OPENROUTER_SMART_REASONING_EFFORT=inherit

# [runtime] upstream 라우팅·데이터 정책 JSON 객체. 빈 객체는 계정/라우터 기본값(보관 제한 보장 없음).
# 지원 필드: only, order, ignore, allow_fallbacks, require_parameters, data_collection, zdr,
# sort, preferred_max_latency, preferred_min_throughput, max_price.
# sort: price | latency | throughput 또는 {"by":"price","partition":"none"}.
# latency(초)/throughput(tokens/s)는 양수 또는 p50/p75/p90/p99별 양수 객체; 선호 조건이지 하드 제한은 아닙니다.
# max_price: prompt/completion(USD/100만 토큰), request(USD/요청) 상한.
# 예시: {"sort":"price","preferred_max_latency":{"p90":3,"p99":8},"preferred_min_throughput":{"p90":50}}
# 추론·함수·JSON Schema 요청의 require_parameters는 adapter가 강제합니다.
OPENROUTER_PROVIDER_PREFERENCES={}

# [startup] 선택적 세션 affinity용 비밀값. 비우면 비활성화; 원본 Discord ID 대신 HMAC을 사용.
OPENROUTER_AFFINITY_SECRET=


# === 06. 도구 / 외부 전송 / 출력 교정 ===

# [runtime] bot_interactions_only(기본): 허용된 히나 참여 대화와 명시적 자기 답장 문맥만 전송.
# 일반 채널 잡담, target history, cross-user public memory 차단; 관리자 서버 공통 메모는 허용.
# full은 신뢰하는 Provider에서 주변 문맥까지 사용할 때만 선택.
EXTERNAL_CONTEXT_POLICY=bot_interactions_only

# [runtime] 웹 검색 fallback 허용. OpenAI web_search / Gemini Google Search / OpenRouter 서버 웹 검색.
CHAT_WEB_SEARCH=true

# [runtime] Gemini: auto | native | delegated. auto는 입력 호환성에 맞춰 선택.
# native는 위임하지 않음; delegated는 원격 계산 도구 제공. 다른 Provider 동작은 변경하지 않음.
CODE_EXECUTION_BACKEND=auto

# [runtime] 출력 교정: off | conservative(LLM 우선) | aggressive(일부 규칙 선처리).
# auto 모델은 현재 fast 모델; 동일 Provider/키 사용. 데드라인 0.25~30초.
OUTPUT_REPAIR_MODE=off
OUTPUT_REPAIR_MODEL=auto
OUTPUT_REPAIR_TIMEOUT_SECONDS=3.0


# === 07. Semantic / Web classifier ===

# [startup] off | shadow | active. 채팅 adaptive routing의 semantic/web 분류; 장기기억에는 미적용.
# shadow는 제안만 기록, active는 실제 선택에 반영. off는 기존 routing 사용.
ROUTING_CLASSIFIER_MODE=off

# [startup] 비어 있는 Provider는 LLM_PROVIDER, 같은 Provider의 빈 모델은 LLM_FAST_MODEL 상속.
# 다른 Provider는 모델 명시 필수. 빈 API 키는 해당 Provider 일반 키 사용.
ROUTING_CLASSIFIER_PROVIDER=
ROUTING_CLASSIFIER_MODEL=
ROUTING_CLASSIFIER_API_KEY=

# [startup] classifier 요청 데드라인(초).
ROUTING_CLASSIFIER_TIMEOUT_SECONDS=4

# [runtime] classifier 응답 전체 생성 토큰 예산.
ROUTING_CLASSIFIER_MAX_OUTPUT_TOKENS=256


# === 08. 대화 동작 / 관계 ===

# [runtime] 메시지 시작 호출어(쉼표 구분, 1~20개, 각 최대 32자).
CALL_PREFIXES=히나야

# [runtime] DM 및 지정 채널에서 모든 사람 메시지에 응답. 다른 봇은 호출어 또는 멘션/답장 핑 필요.
DM_ALWAYS_REPLY=false
ALWAYS_REPLY_CHANNEL_IDS=

# [runtime] 빈 호출, 특별 DM 빈 호출, 빈 모델 응답의 fallback 문구.
# SPECIAL_DM_EMPTY_CALL_REPLY가 비어 있으면 EMPTY_CALL_REPLY 사용.
EMPTY_CALL_REPLY=응? 무슨 일이야?
SPECIAL_DM_EMPTY_CALL_REPLY=응, 선생님. 무슨 일이야?
EMPTY_RESPONSE_REPLY=응, 선생님.

# [startup] 이 사용자의 DM에만 선생님 관계 적용. 비우면 모두 일반 관계; 관리 권한과 별개.
SPECIAL_DM_USER_ID=

# [runtime] 사용자별 호출 cooldown(초).
COOLDOWN_SECONDS=5

# [startup] 동시 처리 요청 상한.
MAX_CONCURRENT_REQUESTS=3


# === 09. 대화 문맥 / 보존 ===

# [startup] 최근 턴 수 및 DB의 scope/table별 raw 보존 목표(HISTORY_TURNS~100000).
# 추출·공개 요약 대기 원본은 보호; 실패 감사 기록은 보호 없이 동일 목표. TTL 없음.
HISTORY_TURNS=12
RAW_RETENTION_TURNS=1000

# [runtime] DM 최근 대화 및 채널 문맥 본문 문자 수 예산. 채널 0은 미전송.
HISTORY_MAX_CHARS=12000
CHANNEL_CONTEXT_CHARS=6000

# [runtime] 최근 서버 채널 문맥 후보 시간창(15~180분). 메시지 수/문자 예산은 별도.
RECENT_CONTEXT_WINDOW_MINUTES=60

# [runtime] 본인-히나 과거 턴 자동 포함의 인접 공백(분). 양수 15~1440은 24시간 절대 상한 적용.
# 0은 공백·24시간 상한 해제(턴 수·문자·privacy/reset 경계 유지). 명시적 답장·검색·기억 저장은 무관.
CONVERSATION_SESSION_GAP_MINUTES=240

# [runtime] legacy | structured | structured_with_replay(실험). 참고 JSON/현재 발화 구조 및 일부 Gemini DM 턴 replay.
# 추가 LLM 호출 없음. 실사용 호환성 확인 후 실험 모드 사용.
CONTEXT_INPUT_MODE=legacy


# === 10. 이미지 / 오디오 입력 ===

# [startup] 현재 호출의 source별 이미지 개수 상한(각 0~32, 합계 32 이하). 0은 해당 source 비활성화.
VISION_MAX_ATTACHMENTS=4
VISION_MAX_EMOJIS=12
VISION_MAX_STICKERS=8

# [runtime] 이미지 개별/총 전송 크기(MiB). 정적 이미지가 제한을 넘으면 자동 압축.
VISION_MAX_IMAGE_MB=5
VISION_MAX_TOTAL_MB=12

# [startup] 공식 외형 참조 이미지 파일 또는 디렉터리. 지원되는 모델의 명시적 이미지 문맥에 추가.
# PNG/JPEG/WebP, 최대 4장·개별 5 MiB·총 12 MiB. 비우면 비활성화. 운영자가 출처/권리 확인.
VISION_HINA_REFERENCE_PATH=

# [startup] 네이티브 오디오 입력(on/off), 개수 및 개별 재생 시간 상한. Gemini 및 지원되는 OpenRouter 모델(WAV/MP3).
# STT 없음. 현재/명시적 답장만 원본 전달; 개별 12 MiB·총 16 MiB, 길이 확인 불가 파일 제외.
AUDIO_INPUT_ENABLED=on
AUDIO_MAX_ATTACHMENTS=2
AUDIO_MAX_SECONDS=300


# === 11. 장기기억 ===

# [runtime] 같은 사용자의 공개 서버 대화를 DM에서 추가 참고.
PUBLIC_SERVER_MEMORY_IN_DM=true

# [runtime] 개인 기억 full/decision, 서버 공유 기억 on/off, 본인 기억 교차 scope on/off(직접 동의 예외).
# Native Decisions 미지원 Provider는 full fallback. docs/gemini-decisions.md 참고.
PERSONAL_MEMORY_READ_MODE=full
SERVER_MEMORY_READ=on
PERSONAL_MEMORY_CROSS_SCOPE=on

# [runtime] 공개 요약/structured 추출의 턴 간격 및 대기 tail을 sweep할 경과 시간(초).
SUMMARY_EVERY=8
STRUCTURED_MEMORY_EVERY=4
STRUCTURED_MEMORY_STALE_AFTER_SECONDS=28800

# [startup] 오래된 tail 검사 간격(초). 0은 sweep 비활성화.
STRUCTURED_MEMORY_SWEEP_INTERVAL_SECONDS=3600

# [startup] 본인 현재 이미지 첨부(본문 있는 턴)의 추출 전 임시 보관 및 용량 제한(16~4096 MB).
# 이미지는 발화 근거 보강용; 사진만으로 기억을 만들지 않음. 추출/삭제/만료 시 임시 파일 제거.
MEMORY_VISUAL_INPUT=off
MEMORY_VISUAL_PENDING_MAX_MB=256

# [startup] Gemini 전용 기억 오디오 입력 및 임시 보관 한도. 본인 현재 메시지의 원본만 대상.
# 일반 오디오 입력 활성화 필요. 추출 및 독립 검증 지원 여부는 경로별로 다름; 기본 off.
MEMORY_AUDIO_INPUT=off
MEMORY_AUDIO_MAX_ATTACHMENTS=2
MEMORY_AUDIO_MAX_SECONDS=120
MEMORY_AUDIO_PENDING_MAX_MB=256


# === 12. 캐릭터 / Lore ===

# [startup] UTF-8 캐릭터 프롬프트 및 lore 경로. 비우면 패키지 기본 파일.
CHARACTER_PROMPT_PATH=
LORE_PATH=

# [runtime] full | tool | off | decision. full은 정적 lore 전체(compact, 관객 전용 제외) + runtime knowledge 검색.
# tool은 모델이 search_lore를 필요할 때 호출(답변당 최대 2회); off는 lore 검색 중단.
# decision은 지원되는 Native Decisions를 사용하며 실패/미지원 시 full fallback.
RAG_MODE=full

# [runtime] 로컬 검색 결과 항목 및 문자 수 예산.
LORE_MAX_ITEMS=6
LORE_MAX_CHARS=3200

# [runtime] false이면 community_meme 항목 제외.
COMMUNITY_LORE=true


# === 13. 시간 / 지역 ===

# [runtime] 현재 시각 및 상대 날짜 해석의 기준.
RUNTIME_TIMEZONE=Asia/Seoul
RUNTIME_LOCALE=ko-KR

# [runtime] 지역 미지정 날씨·교통·영업시간 fallback. 실제 사용자 위치로 간주하지 않음.
# 비우면 일반 대화용 날씨 캐시 네트워크 호출도 하지 않음.
RUNTIME_DEFAULT_LOCATION=


# === 14. 저장소 / 로그 / 대시보드 ===

# [startup] 기억·메모·설정 override 등을 저장하는 SQLite. data/는 Git 제외 및 Docker 볼륨 보존.
DATABASE_PATH=data/hina.sqlite3

# [startup] 선택적 빌드 revision SHA. 비우면 Git HEAD 또는 source fingerprint 자동 감지.
HINA_GIT_SHA=

# [startup] 구조화 로그 경로. 빈 값은 해당 파일 로깅 비활성화.
USAGE_LOG_PATH=data/logs/usage.jsonl
EVENT_LOG_PATH=data/logs/events.jsonl

# [startup] 대시보드 bind/port 및 audited admin write 활성화. write 활성화 시 loopback만 허용.
# 인증이 없는 환경에서는 localhost bind 유지.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
DASHBOARD_ENABLE_WRITES=false

# [startup] 별도 mount/read-only 경로일 때만 지정. 비우면 봇 설정 경로 재사용.
DASHBOARD_DATABASE_PATH=
DASHBOARD_USAGE_LOG_PATH=
DASHBOARD_EVENT_LOG_PATH=
