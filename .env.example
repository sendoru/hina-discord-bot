# .env.example 구성 규칙
# [runtime]: 시작 시 기본값이며, /config set으로 저장한 SQLite override가 있으면 즉시 적용됩니다.
# 표시가 없는 값은 별도 설명이 없는 한 시작 시 환경변수에서 읽습니다.
# 빈 값의 의미(기본값 상속, 기능 비활성화 등)는 각 항목의 주석을 따릅니다.

# --- Discord / access ---

DISCORD_TOKEN=

# 비우면 초대된 모든 서버에서 사용합니다. 쉼표로 구분한 서버 ID입니다.
ALLOWED_GUILD_IDS=

# 앱 소유자 외에 이모지·기억 모드·동적 instruction/knowledge·runtime config 관리를 허용할 Discord 사용자 ID.
# 여러 명이면 쉼표로 구분합니다. 예: BOT_ADMIN_IDS=123456789012345678,234567890123456789
# 변경 후 봇을 재시작해야 적용됩니다. 서버 Administrator 권한과는 별개입니다.
BOT_ADMIN_IDS=

# 히나 답변의 일반 사용자 멘션(<@id>, <@!id>)을 실제 알림으로 허용할지 정합니다.
# false이면 사용자 멘션도 전송 전에 비활성화합니다. @everyone/@here/역할 멘션은 항상 차단됩니다.
# startup-only 설정이며 변경 후 재시작해야 적용됩니다.
ALLOW_USER_MENTIONS=true


# --- LLM provider / credentials ---

# 답변과 기억 처리에 사용할 provider: openai, gemini, openrouter
LLM_PROVIDER=openai

# 사용하는 provider의 키만 필수입니다.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=


# --- Model selection / generation ---

# fixed는 LLM_MODEL 하나를 사용합니다. adaptive는 fast/smart 모델과 추론 강도를 선택합니다.
# 채팅과 장기 기억은 같은 모델 pool을 공유하지만 routing score의 의미는 서로 다릅니다.
MODEL_ROUTING_MODE=fixed

# [runtime] fixed 모드에서 사용할 모델입니다. provider 자체는 startup-only입니다.
# 기존 OPENAI_MODEL도 OpenAI 설정의 호환 alias로 계속 읽습니다.
LLM_MODEL=gpt-4.1-mini

# [runtime] adaptive 모드의 fast/smart 모델입니다. 비우면 시작 시 LLM_MODEL을 상속합니다.
LLM_FAST_MODEL=
LLM_SMART_MODEL=

# [runtime] 채팅의 request/context/ambient/evidence/visual load + semantic score가 이 값 이상이면 smart.
# [runtime] 장기 기억의 capacity load + pending payload load가 이 값 이상이면 smart.
# 두 값의 허용 범위는 0.1~10.0입니다.
MODEL_ROUTING_SMART_THRESHOLD=2.0
MEMORY_ROUTING_SMART_THRESHOLD=2.0

# provider 공통 전체 생성 예산입니다. reasoning/thought token도 이 한도에 포함될 수 있습니다.
# adaptive에서 명시적인 긴 답변 요청은 fast tier를 유지하면서 SMART_MAX_OUTPUT_TOKENS를 사용할 수 있습니다.
FAST_MAX_OUTPUT_TOKENS=4096
SMART_MAX_OUTPUT_TOKENS=8192

# [runtime] fixed 모드에서 사용하는 provider 공통 전체 생성 예산입니다.
MAX_OUTPUT_TOKENS=1000

# 장기 기억 요약의 provider 공통 전체 생성 예산입니다. Gemini에서는 thought token도 포함됩니다.
# fast/smart memory route 모두 이 예산을 사용합니다.
MEMORY_MAX_OUTPUT_TOKENS=4096


# --- Semantic / web routing classifier ---

# 채팅 adaptive routing의 semantic/web classifier입니다. 장기 기억 routing에는 적용되지 않습니다.
# off: chat-v6 + deterministic web 정책만 사용
# shadow: 실제 route는 유지하고 classifier가 제안한 model/web route를 비동기로 기록
# active: semantic score와 web_need를 실제 선택에 반영한 chat-hybrid-v6 사용
# startup-only 설정이며 변경 후 재시작해야 합니다.
ROUTING_CLASSIFIER_MODE=off

# 비우면 LLM_PROVIDER를 사용합니다. 다른 provider를 쓰면 MODEL을 반드시 명시해야 합니다.
ROUTING_CLASSIFIER_PROVIDER=
# 같은 provider에서 비우면 LLM_FAST_MODEL을 사용합니다.
ROUTING_CLASSIFIER_MODEL=
# 비우면 classifier provider의 일반 API key를 재사용합니다. 별도 quota/account 분리에 사용할 수 있습니다.
ROUTING_CLASSIFIER_API_KEY=
ROUTING_CLASSIFIER_TIMEOUT_SECONDS=4
ROUTING_CLASSIFIER_MAX_OUTPUT_TOKENS=256


# --- Gemini-specific options ---

# [runtime] Gemini의 추론 강도입니다.
# fixed에서는 GEMINI_THINKING_LEVEL, adaptive에서는 fast/smart 값을 채팅과 기억 모두 사용합니다.
GEMINI_THINKING_LEVEL=low
GEMINI_FAST_THINKING_LEVEL=minimal
GEMINI_SMART_THINKING_LEVEL=medium

# [runtime] Gemini adapter를 거치는 모든 요청의 interaction을 provider 측에 저장할지 정합니다.
# 일반 채팅 answer뿐 아니라 memory summary/classifier 등 내부 보조 호출도 포함합니다.
# false가 기본이며, AI Studio Logs에서 raw request/response를 확인할 때만 켭니다.
GEMINI_STORE_INTERACTIONS=false


# --- External context / web search ---

# [runtime] 외부 모델 요청으로 보낼 수 있는 대화 문맥의 최종 경계입니다.
# privacy-safe 기본값은 bot_interactions_only입니다. 현재 채널에서 히나가 직접 참여한 대화와
# 이번 호출에서 사용자가 명시적으로 답장 대상으로 고른 자기 메시지만 허용합니다.
# 일반 채널 잡담, target history, cross-user public memory, 서버 공통 메모는 차단합니다.
# full은 신뢰하는 provider에서 주변 문맥까지 사용해야 할 때만 선택하세요.
EXTERNAL_CONTEXT_POLICY=bot_interactions_only

# [runtime] 일반 답변에서 provider의 웹 검색 기능을 fallback으로 허용합니다.
# OpenAI Responses web_search, Gemini Google Search, OpenRouter web plugin으로 변환됩니다.
CHAT_WEB_SEARCH=true


# --- Runtime locale / ambient context ---

# 현재 시각과 상대 날짜 해석에 사용하는 봇 런타임 기준입니다.
RUNTIME_TIMEZONE=Asia/Seoul
RUNTIME_LOCALE=ko-KR

# [runtime] 날씨·교통·영업시간 등에서 사용자가 지역을 생략했을 때만 fallback으로 사용합니다.
# 실제 사용자 위치로 간주하지 않으며, 값이 있으면 일반 잡담의 현재 날씨도 약 20분 단위로 캐시합니다.
# 비우면 날씨 캐시 네트워크 호출도 하지 않습니다.
RUNTIME_DEFAULT_LOCATION=


# --- Vision input ---

# 현재 호출 메시지에서 vision input으로 전달할 source별 개수 상한입니다.
# 0이면 해당 source를 끕니다. 세 값은 각각 0~32, 합계는 32 이하여야 합니다.
# 파일 크기 제한은 별도로 개별 5 MiB, 한 호출 합계 12 MiB가 적용됩니다.
VISION_MAX_ATTACHMENTS=4
VISION_MAX_EMOJIS=12
VISION_MAX_STICKERS=8


# --- Conversation behavior ---

# [runtime] 메시지 시작에서 인식할 호출어. 쉼표 구분, 1~20개, 각각 최대 32자입니다.
# 캐릭터의 이름/설정/프로필 사실은 프롬프트와 lore에서 관리합니다.
CALL_PREFIXES=히나야

# 호출어/멘션만 보내고 본문이 비어 있을 때의 고정 응답입니다. 변경 후 재시작해야 적용됩니다.
EMPTY_CALL_REPLY=응? 무슨 일이야?
# SPECIAL_DM_USER_ID의 빈 호출에만 사용합니다. 비우면 EMPTY_CALL_REPLY를 그대로 사용합니다.
SPECIAL_DM_EMPTY_CALL_REPLY=응, 선생님. 무슨 일이야?
# 모델이 빈 문자열을 반환했을 때 Discord에 보낼 최종 fallback입니다.
EMPTY_RESPONSE_REPLY=응, 선생님.

# [runtime] false: DM에서도 멘션 또는 호출어가 필요합니다.
DM_ALWAYS_REPLY=false
# [runtime] 쉼표로 구분한 서버 채널 ID 목록입니다. 지정된 채널에서는 사람의 모든 메시지에
# DM_ALWAYS_REPLY처럼 응답합니다. 다른 봇은 여기서도 호출어 또는 멘션/답장 핑이 필요합니다.
ALWAYS_REPLY_CHANNEL_IDS=

COOLDOWN_SECONDS=5
MAX_CONCURRENT_REQUESTS=3


# --- Conversation context limits ---

HISTORY_TURNS=12
# [runtime] DM 최근 대화 본문 합계 상한(문자 수). 최신 완전한 턴부터 포함합니다.
HISTORY_MAX_CHARS=12000
# [runtime] 최근 채널 문맥 본문 합계 문자 수 상한. 0이면 전달하지 않습니다.
CHANNEL_CONTEXT_CHARS=6000


# --- Memory / relationship ---

# [runtime] 공개 채널에서 같은 사용자가 나눈 대화를 DM에서만 추가 참고합니다.
PUBLIC_SERVER_MEMORY_IN_DM=true

# 이 사용자와의 DM에서만 선생님 관계를 적용합니다. 비우면 모두 일반 관계이며 관리 권한과는 별개입니다.
SPECIAL_DM_USER_ID=

# 기존 text summary는 이 턴 수마다 갱신합니다.
SUMMARY_EVERY=8
# structured memory extractor는 별도 cursor를 사용해 더 자주 실행합니다.
STRUCTURED_MEMORY_EVERY=4
# 2~3턴에서 대화가 멈춘 tail은 이 시간이 지난 뒤 background sweep 대상으로 봅니다.
STRUCTURED_MEMORY_STALE_AFTER_SECONDS=28800
# 0이면 stale sweep을 끕니다. 기본 3600초(1시간)마다 오래된 tail을 확인합니다.
STRUCTURED_MEMORY_SWEEP_INTERVAL_SECONDS=3600


# --- Character prompt / lore ---

# 비우면 패키지 내 기본 프롬프트를 사용합니다. UTF-8 파일 경로를 지정할 수 있습니다.
CHARACTER_PROMPT_PATH=

# 승인된 설정 중 현재 질문과 관련된 항목만 별도 API 호출 없이 전달합니다.
# 비우면 패키지의 src/hina_bot/data/lore.jsonl을 사용합니다.
LORE_PATH=
# [runtime]
LORE_MAX_ITEMS=6
LORE_MAX_CHARS=3200
# [runtime] false면 community_meme 항목을 런타임에서 전부 제외합니다.
COMMUNITY_LORE=true


# --- Storage ---

# 기억/메모/이모지뿐 아니라 /instruction, /knowledge, /config override도 이 SQLite에 저장합니다.
# data/는 Git에서 제외되고 Docker에서는 named volume에 보존됩니다.
DATABASE_PATH=data/hina.sqlite3


# --- Telemetry / logging ---

# 구조화 telemetry는 app_version/build_revision/runtime_id를 함께 기록합니다.
# 보통 로컬 checkout의 Git HEAD를 자동 감지하고 Git metadata가 없는 이미지에서는 source fingerprint로 fallback합니다.
# 배포 시스템에서 정확한 commit SHA를 알고 있으면 선택적으로 주입할 수 있습니다.
HINA_GIT_SHA=

# 빈 값이면 해당 파일 로깅을 끕니다.
USAGE_LOG_PATH=data/logs/usage.jsonl
EVENT_LOG_PATH=data/logs/events.jsonl


# --- Observability / admin dashboard ---

# 기본 경로는 DATABASE_PATH/USAGE_LOG_PATH/EVENT_LOG_PATH를 재사용합니다.
# 인증 기능을 추가하기 전에는 localhost bind를 유지하세요.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# 명시적으로 켠 경우에만 audited admin command queue에 write 요청을 넣습니다.
# true일 때 DASHBOARD_HOST는 loopback만 허용됩니다.
DASHBOARD_ENABLE_WRITES=false

# 별도 mount/read-only 경로를 사용할 때만 지정합니다.
DASHBOARD_DATABASE_PATH=
DASHBOARD_USAGE_LOG_PATH=
DASHBOARD_EVENT_LOG_PATH=


# --- Legacy migration only ---

# hina-migrate-runtime 전용입니다. 일반 봇/eval 런타임 Settings에는 포함되지 않으며,
# 예전 JSON 저장 형식을 SQLite로 이전할 때만 읽습니다.
INSTRUCTION_PATH=data/instructions.json
RUNTIME_LORE_PATH=data/runtime_lore.json
CONTEXT_PATH=data/contexts.json
